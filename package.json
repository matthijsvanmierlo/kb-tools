{
  "name": "kennisboost-tools",
  "version": "1.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "NODE_OPTIONS='-r ./tests/setup-fs-patch.cjs' vitest run",
    "test:watch": "NODE_OPTIONS='-r ./tests/setup-fs-patch.cjs' vitest",
    "build:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.output.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.output.css --watch",
    "relay": "node server/relay/index.js",
    "relay:add-teacher": "node scripts/relay-add-teacher.mjs",
    "relay:init": "node scripts/relay-init.mjs",
    "relay:cf:dev": "wrangler dev",
    "relay:cf:deploy": "wrangler deploy",
    "relay:cf:schema": "wrangler d1 execute kb-relay-db --remote --file=./server/relay/schema.sql",
    "escrow:keygen": "node scripts/escrow-keygen.mjs",
    "escrow:recover": "node scripts/escrow-recover.mjs",
    "vendor": "node scripts/vendor.mjs",
    "csp": "node scripts/csp.mjs",
    "build:sw": "node scripts/sw-manifest.mjs",
    "build": "npm run build:css && npm run csp && npm run build:sw"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "lz-string": "^1.5.0",
    "marked": "^18.1.1",
    "papaparse": "^5.7.0",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^3.4.19",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
