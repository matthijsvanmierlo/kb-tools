{
  "id": "./",
  "name": "KennisBoost Tools",
  "short_name": "KennisBoost",
  "description": "100% Client-Side Local-First Educational Technology Suite",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "KennisBoost lesson",
      "icons": [{ "src": "icons/file-kbshare-96.png", "sizes": "96x96", "type": "image/png" }],
      "accept": {
        "application/vnd.kennisboost.share+json": [".kbshare"]
      }
    },
    {
      "action": "./index.html",
      "name": "KennisBoost student submission",
      "icons": [{ "src": "icons/file-kbsub-96.png", "sizes": "96x96", "type": "image/png" }],
      "accept": {
        "application/vnd.kennisboost.submission": [".kbsub"],
        "application/vnd.kennisboost.receipt": [".kbr"]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [".kbshare", ".kbsub", ".kbr", ".zip", ".json", ".txt", "application/json", "application/zip", "text/plain", "application/octet-stream"]
        }
      ]
    }
  }
}
